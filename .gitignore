# глубокий дизайн (RU) — системная папка, в git не хранится (см. structure.md)
docs/

# зависимости
node_modules/

# артефакты сборки TS (на случай перехода с noEmit на dist/)
dist/
*.tsbuildinfo

# логи npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# атомарная запись infra/fs.ts (temp + rename) — на случай оборванного прогона
*.tmp

# окружение
.env
.env.*

# macOS
.DS_Store

# редакторы
.idea/
.vscode/

# мусорные выводы ручных прогонов CLI (apply --out) — в git не хранятся
/out.cpp

# корпус ручных прогонов на chromium/brave (данные качаются, в git не хранятся)
/corpus/

# грамматики tree-sitter: не хранятся в git — качаются в пользовательский кеш
# (`npm run grammars`), см. src/infra/grammar-store.ts
/grammars/
