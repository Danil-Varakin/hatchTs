# The repository standard, so an editor gets it right before any check runs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Golden fixtures are DATA: their bytes are the test. Never normalise them.
[test/golden/**]
trim_trailing_whitespace = false
insert_final_newline = false
