{
  "name": "hatch",
  "version": "0.4.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "PROTOCOL.md",
    "LICENSE",
    "hatch.config.schema.json",
    "schemas",
    "grammars"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "apply": "node --experimental-strip-types src/bin/hatch.ts apply",
    "generate": "node --experimental-strip-types src/bin/hatch.ts generate",
    "grammars": "node --experimental-strip-types scripts/fetch-grammars.ts",
    "pretest": "node --experimental-strip-types scripts/fetch-grammars.ts",
    "hatch": "node --experimental-strip-types src/bin/hatch.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node --experimental-strip-types scripts/fetch-grammars.ts && npm run build",
    "prepare": "npm run build",
    "pack": "npm run check && npm pack",
    "service": "node --experimental-strip-types src/bin/service.ts",
    "build:apply-bin": "node scripts/build-apply-bin.mjs",
    "smoke:apply-bin": "node test/golden/run-binary.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.26.10"
  },
  "bin": {
    "hatch": "dist/bin/hatch.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "default": "./dist/service/index.js"
    },
    "./protocol": {
      "types": "./dist/service/protocol.d.ts",
      "default": "./dist/service/protocol.js"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
