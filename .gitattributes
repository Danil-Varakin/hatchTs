# Line endings: LF in the repository, whatever the operating system or editor.
* text=auto eol=lf

# tree-sitter grammars are binary: never normalized.
*.wasm binary

# Golden fixtures are DATA: their bytes are what the tests are about — CRLF, a BOM,
# a missing trailing newline. Normalizing them destroys the case (cpp/74, "the whole
# file was converted from CRLF to LF", would leave old and new identical).
test/golden/** -text
