# deep design notes (RU): a working folder, kept out of git (see structure.md)
docs/

# dependencies
node_modules/

# TypeScript build output
dist/
*.tsbuildinfo

# npm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# leftovers of the atomic write in infra/fs.ts, should a run be interrupted
*.tmp

# environment
.env
.env.*

# macOS
.DS_Store

# editors
.idea/
.vscode/

# scratch output of manual CLI runs (apply --out): never committed
/out.cpp

# the manual-run corpus over chromium/brave: fetched data, never committed
/corpus/

# tree-sitter grammars: not committed — scripts/fetch-grammars.ts puts the pinned ones
# here (`npm run grammars`, pretest, prepack) and `npm pack` ships them inside hatch
/grammars/

# hatch-apply as scripts/build-apply-bin.mjs builds it
/build/

# the archive npm pack produces
*.tgz

# local assistant files: instructions, settings, caches — kept on this machine only
CLAUDE.md
CLAUDE.local.md
.claude/
.mcp.json
AGENTS.md
GEMINI.md
.cursor/
.cursorrules
.windsurfrules
.aider*
.continue/
.github/copilot-instructions.md
