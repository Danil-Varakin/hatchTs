{
  "name": "hatch",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "check": "npm run typecheck && npm test",
