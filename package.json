{
  "name": "hatch",
  "version": "0.1.1",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "hatch.config.schema.json"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "check": "npm run typecheck && npm test",
    "apply": "node --experimental-strip-types src/cli/index.ts apply",
    "generate": "node --experimental-strip-types src/cli/index.ts generate",
    "grammars": "node --experimental-strip-types src/cli/index.ts grammars",
    "pretest": "node --experimental-strip-types src/cli/grammars.ts",
    "hatch": "node --experimental-strip-types src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "pack": "npm run check && npm pack",
    "service": "node --experimental-strip-types src/service/index.ts"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "diff": "^8.0.4",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.26.10"
  },
  "bin": {
    "hatch": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service/index.d.ts",
      "default": "./dist/service/index.js"
    },
    "./protocol": {
      "types": "./dist/service/protocol.d.ts",
      "default": "./dist/service/protocol.js"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
